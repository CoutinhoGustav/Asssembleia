# ===========================================
# Frontend - Variáveis de Ambiente
# ===========================================

# URL do Backend API
# Local / Docker:
VITE_API_URL=http://localhost:3002

# Produção (Vercel) — substitua pela URL do backend deployado:
# VITE_API_URL=https://seu-backend.vercel.app

# Mock API (true = usa mock, false = usa API real)
VITE_USE_MOCK=false
