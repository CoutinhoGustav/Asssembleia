{
    "version": 2,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": ".",
    "functions": {
        "dist/main.js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/dist/main.js"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Access-Control-Allow-Methods", "value": "GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS" },
                { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Accept, Authorization, x-auth-token, Bypass-Tunnel-Reminder, bypass-tunnel-reminder" }
            ]
        }
    ]
}